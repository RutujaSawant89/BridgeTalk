# Copy to .env and fill in. Set ONE of these:

# Your own backend proxy (recommended for release builds; the key stays on the server)
EXPO_PUBLIC_API_URL=

# Or call Groq directly (dev only: this key gets bundled into the app)
EXPO_PUBLIC_GROQ_API_KEY=

# Shared token the proxy checks (must match APP_TOKEN on the server). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EXPO_PUBLIC_APP_TOKEN=
